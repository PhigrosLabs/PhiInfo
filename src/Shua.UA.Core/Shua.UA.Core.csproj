<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
        <LangVersion>14</LangVersion>

        <PackageId>Shua.UA.Core</PackageId>
        <Version>0.1.0</Version>
        <Authors>Shua</Authors>
        <Description>Shua's Unity Analysis Library</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/PhigrosLabs/PhiInfo</RepositoryUrl>
        <RootNamespace>Shua.UA.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AssetsTools.NET" Version="3.0.4"/>
        <PackageReference Include="AssetsTools.NET.Cpp2IL" Version="3.0.4"/>
        <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-pre-release.19"/>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json" Version="10.0.3"/>
        <PackageReference Include="System.Memory" Version="4.6.3"/>
    </ItemGroup>

</Project>