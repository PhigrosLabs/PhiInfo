<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7"/>
        <PackageReference Include="ModelContextProtocol" Version="1.2.0"/>
        <ProjectReference Include="..\PhiInfo.Processing\PhiInfo.Processing.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.2.0</Version>
        <GitHash>dev</GitHash>
        <InformationalVersion>$(Version)+$(GitHash)</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <PackageId>PhigrosLabs.PhiInfo.Mcp</PackageId>
        <Authors>PhigrosLabs</Authors>
        <Description>The MCP Server of PhiInfo.Processing</Description>
        <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/PhigrosLabs/PhiInfo</RepositoryUrl>
    </PropertyGroup>

</Project>
